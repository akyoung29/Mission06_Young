@model Form

@{
    ViewData["Title"] = "Movie Form";
}

<div>
    <!--Title-->
    <h2>Enter a New Movie</h2>

    <form method="post">
        <!-- Hidden MovieId for editing -->
        <input type="Hidden" asp-for="MovieId" />

        <!--Dropdown for categories-->
        <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
            <option value="">Select A Category</option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
        <br /><br />

        <!--Movie Title-->
        <label asp-for="Title">Title:</label>
        <input asp-for="Title"><br><br>

        <!--Year Released-->
        <label asp-for="Year">Year Released:</label>
        <input asp-for="Year" type="number"><br><br>

        <!--Director-->
        <label asp-for="Director">Director:</label>
        <input asp-for="Director"><br><br>

        <!--Dropdown menu for rating-->
        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating" typeof="checkbox" value = "true">
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select><br><br>

        <!-- True/ false and optional for edited -->
        <label asp-for="Edited">Edited:</label>
        <input asp-for="Edited" type="checkbox"value="true"><br><br>

        <!--Optional lent to-->
        <label asp-for="LentTo">Lent To:</label>
        <input asp-for="LentTo"><br><br>

        <!-- True/ false and optional for plex -->
        <label asp-for="CopiedToPlex">Copied To Plex:</label>
        <input asp-for="CopiedToPlex" type="checkbox" value="true"><br><br>

        <!--Optional notes with 25 characters max-->
        <label asp-for="Notes">Notes (max 25 characters):</label>
        <input asp-for="Notes" maxlength="25"><br><br>

        <!--Submit form-->
        <button type="submit">Add Movie</button>

        <!--Validate Data, and return what is invalid-->
        <div asp-validation-summary="All"></div>
    </form>
</div>
